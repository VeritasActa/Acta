{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritasacta.com/schemas/agent-governance-declaration.schema.json",
  "title": "Agent Governance Declaration",
  "description": "A vendor-neutral declaration for projects that use AI agents in production or security-relevant workflows.",
  "type": "object",
  "required": ["schema_version", "project", "agent_assisted_production"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "required": ["name", "repository"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri" },
        "security_insights": { "type": "string", "format": "uri" }
      }
    },
    "agent_assisted_production": {
      "type": "object",
      "required": ["used", "human_review", "governed_operations"],
      "additionalProperties": false,
      "properties": {
        "used": { "type": "boolean" },
        "human_review": { "type": "boolean" },
        "governed_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["code-generation", "code-review", "security-analysis", "policy-evaluation", "dependency-update", "release-automation", "incident-response", "other"]
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval_required_for": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "prohibited_actions": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emitted": { "type": "boolean" },
            "formats": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "public_examples": {
              "type": "array",
              "items": { "type": "string", "format": "uri" },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
